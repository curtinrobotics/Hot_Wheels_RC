(footprint "BEC_QITN_Matek_Micro_18x16mm_Castellated" (version 20221018) (generator "ChatGPT")
  (descr "QITN/Matek Micro BEC 6-60V to 5V/9V/12V module, approx 18 x 15/16 x 4.5 mm, 4 castellated pads at 2.54 mm pitch. Verify against your actual module before ordering PCB.")
  (tags "BEC buck regulator QITN Matek mBEC12S 6-60V 5V 9V 12V")
  (attr smd)
  (fp_text reference "REF**" (at 0 -9.9 0) (layer "F.SilkS")
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text value "BEC_QITN_Matek_Micro_18x16mm" (at 0 9.9 0) (layer "F.Fab")
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text user "${REFERENCE}" (at 0 0 0) (layer "F.Fab")
    (effects (font (size 1 1) (thickness 0.15)))
  )
  ; Board outline, centered. Module approx 18 mm wide by 16 mm high.
  (fp_line (start -9 -8) (end 9 -8) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
  (fp_line (start 9 -8) (end 9 8) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
  (fp_line (start 9 8) (end -9 8) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
  (fp_line (start -9 -8) (end -9 -5.45) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
  (fp_line (start -9 5.45) (end -9 8) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))

  (fp_line (start -9 -8) (end 9 -8) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
  (fp_line (start 9 -8) (end 9 8) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
  (fp_line (start 9 8) (end -9 8) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
  (fp_line (start -9 8) (end -9 -8) (stroke (width 0.1) (type solid)) (layer "F.Fab"))

  (fp_rect (start -9.5 -8.5) (end 9.5 8.5) (stroke (width 0.05) (type solid)) (fill none) (layer "F.CrtYd"))

  ; Pin labels for component side up, pads on left edge:
  ; top to bottom = OUT, GND, GND, IN
  (fp_text user "OUT" (at -5.8 -3.81 0) (layer "F.SilkS")
    (effects (font (size 0.8 0.8) (thickness 0.12)))
  )
  (fp_text user "GND" (at -5.8 -1.27 0) (layer "F.SilkS")
    (effects (font (size 0.8 0.8) (thickness 0.12)))
  )
  (fp_text user "GND" (at -5.8 1.27 0) (layer "F.SilkS")
    (effects (font (size 0.8 0.8) (thickness 0.12)))
  )
  (fp_text user "IN" (at -5.8 3.81 0) (layer "F.SilkS")
    (effects (font (size 0.8 0.8) (thickness 0.12)))
  )

  (pad "1" smd roundrect (at -8.85 -3.81) (size 2.3 1.45) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.1724))
  (pad "2" smd roundrect (at -8.85 -1.27) (size 2.3 1.45) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.1724))
  (pad "3" smd roundrect (at -8.85 1.27) (size 2.3 1.45) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.1724))
  (pad "4" smd roundrect (at -8.85 3.81) (size 2.3 1.45) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.1724))

  (model "${KICAD8_3DMODEL_DIR}/Connector_PinHeader_2.54mm.3dshapes/PinHeader_1x04_P2.54mm_Vertical.wrl"
